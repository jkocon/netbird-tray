// NetBird Tray: start/stop/restart usługi NetBird (netbird.service albo netbird@<iface>.service) bez hasła
// dla użytkowników z grupy wheel w aktywnej, lokalnej sesji. Włączanie autostartu (enable/disable)
// nadal pyta o hasło. Połącz/rozłącz nie potrzebuje tej reguły - idzie przez socket demona (netbird up/down).
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit") || "";
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        /^netbird(@[A-Za-z0-9_-]+)?\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
